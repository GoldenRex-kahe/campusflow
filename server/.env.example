# Copy to .env, or run: npm run db:setup (it creates .env for you)
PORT=4000
DB_DRIVER=postgres
DATABASE_URL=postgres://campusflow:CHANGE_ME@localhost:5432/campusflow
JWT_SECRET=CHANGE_ME_long_random_text
COLLEGE_EMAIL_DOMAIN=college.edu

# console = print login codes in the terminal (development), smtp = send real emails
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# set to 1 if the server runs behind a proxy such as Cloudflare Tunnel
# TRUST_PROXY=1

# attendance rules
COLLEGE_TIMEZONE=Asia/Kolkata
ATTENDANCE_WINDOW_MINUTES=20
REOPEN_MINUTES=10

# optional AI writing for summaries (off by default)
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# optional: key that encrypts secrets in the database. Set it BEFORE turning on 2FA and never change it.
# ENCRYPTION_KEY=long_random_text
