{
  "expo": {
    "name": "CampusFlow",
    "slug": "campusflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CampusFlow uses the camera to scan the attendance QR code."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusFlow checks your location only at the moment you mark attendance, to confirm you are in the classroom."
        }
      ]
    ]
  }
}